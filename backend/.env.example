# ── Required ──────────────────────────────────────────────────────────
PORT=4000
MONGODB_URI="mongodb://username:password@host:port/database"
ACCESS_TOKEN_SECRET=generate_a_strong_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRY=1d
QUESTION_ENCRYPTION_KEY=generate_a_32_byte_base64_key

# ── CORS ──────────────────────────────────────────────────────────────
# In production, set this to your frontend domain (e.g., https://zeroleak.example.com)
CORS_ORIGIN=http://localhost:3000

# ── Bootstrap Secrets (required for first admin/auditor creation) ─────
ADMIN_BOOTSTRAP_SECRET=generate_a_strong_bootstrap_secret
AUDITOR_BOOTSTRAP_SECRET=generate_a_strong_bootstrap_secret

# ── Blockchain ────────────────────────────────────────────────────────
# Set to "mock" for local dev without Fabric, "production" for real Fabric
BLOCKCHAIN_MODE=mock

# Fabric config (required when BLOCKCHAIN_MODE=production)
# FABRIC_CREDENTIAL_PATH=/path/to/fabric/organizations/peerOrganizations/org1.example.com
# FABRIC_CHANNEL=mychannel
# FABRIC_CHAINCODE=integrityContract
# FABRIC_ORG=Org1MSP
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Polygon Anchor (required when BLOCKCHAIN_MODE=production)
# POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGON_PRIVATE_KEY=your_wallet_private_key
# POLYGON_CONTRACT_ADDRESS=your_deployed_contract_address

# ── Environment ───────────────────────────────────────────────────────
# NODE_ENV=production  # Set in production for secure cookies + error sanitization
