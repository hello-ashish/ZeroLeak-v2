PORT=4000
MONGODB_URI=mongodb+srv://youruser:yourpassword@yourcluster.mongodb.net/zeroleak
REDIS_URL=redis://default:yourpassword@your-redis-host:port

ACCESS_TOKEN_SECRET=your-very-long-random-secret-here
ACCESS_TOKEN_EXPIRY=1d
QUESTION_ENCRYPTION_KEY=base64-encoded-32-byte-key-here

CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b

# ─── Hyperledger Fabric Integration ─────────────────────────────────────────
# DEVELOPMENT ONLY — The Fabric test network is not a production deployment.
# Prerequisites:
#   1. Install Hyperledger Fabric binaries + fabric-samples:
#      curl -sSL https://bit.ly/2ysbOFE | bash -s -- 2.5.0 1.5.5
#   2. Start the network:  npm run fabric:up
#   3. Deploy chaincode:   npm run fabric:deploy
#   4. Set FABRIC_ENABLED=true below
FABRIC_ENABLED=false
FABRIC_CHANNEL_NAME=zeroleak-channel
FABRIC_CHAINCODE_NAME=zeroleak
FABRIC_MSP_ID=Org1MSP
FABRIC_CRYPTO_PATH=/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
FABRIC_CERT_DIRECTORY_PATH=
FABRIC_KEY_DIRECTORY_PATH=
FABRIC_TLS_CERT_PATH=/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_CONNECT_TIMEOUT_MS=30000
FABRIC_ENDORSE_TIMEOUT_MS=30000
FABRIC_SUBMIT_TIMEOUT_MS=60000
FABRIC_COMMIT_STATUS_TIMEOUT_MS=60000

# ─── Frontend Environment Variables (for reference) ───────────────────────
# The following variables should be placed in `frontend/.env`
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
# VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
